# Entrada de dados: lê o valor total da compra
valor_compra = float(input("Digite o valor total da compra (R$): "))

# Condições para definir o percentual de desconto
if valor_compra < 200.00:
    desconto_percentual = 5
elif valor_compra < 300.00:  # Já sabemos que é maior ou igual a 200 se chegou aqui
    desconto_percentual = 10
else:  # Qualquer valor maior ou igual a 300
    desconto_percentual = 15

# Cálculos do desconto e do valor final
valor_desconto = valor_compra * (desconto_percentual / 100)
valor_final = valor_compra - valor_desconto

# Exibição dos resultados formatados com 2 casas decimais
print(f"\n--- Resumo da Compra ---")
print(f"Valor original: R$ {valor_compra:.2f}")
print(f"Desconto aplicado: {desconto_percentual}% (Economia de R$ {valor_desconto:.2f})")
print(f"Valor total a pagar: R$ {valor_final:.2f}")
